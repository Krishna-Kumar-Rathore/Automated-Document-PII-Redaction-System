# ---- Virtual environments ----
.venv/
venv/
env/
myenv/

# ---- Python cache / build ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# ---- Test / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Generated pipeline outputs ----
outputs/

